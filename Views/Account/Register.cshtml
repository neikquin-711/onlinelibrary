@{ ViewData["Title"] = "Tạo tài khoản"; }
<section class="account-page wrap"><div class="account-card">
    <div class="eyebrow"><span class="eyebrow-line"></span> GIA NHẬP CỘNG ĐỒNG ĐỌC</div><h1>Tạo tài khoản <em>độc giả.</em></h1><p>Một thư viện của riêng bạn, luôn sẵn sàng đồng hành.</p>
    @if(ViewBag.Error is not null){<div class="form-error">@ViewBag.Error</div>}
    @if(ViewBag.RegistrationEnabled is not false){<form asp-action="Register" method="post" class="document-form"><div class="form-field wide"><label for="displayName">Tên hiển thị</label><input id="displayName" name="displayName" maxlength="80" required autocomplete="name"/></div><div class="form-field wide"><label for="email">Email</label><input id="email" name="email" type="email" maxlength="254" required autocomplete="email"/></div><div class="form-field wide"><label for="password">Mật khẩu</label><input id="password" name="password" type="password" minlength="10" maxlength="128" required autocomplete="new-password"/><small class="field-hint">Ít nhất 10 ký tự, gồm chữ hoa, chữ thường và số.</small></div><div class="form-actions"><button class="primary-button" type="submit">Tạo tài khoản <span>→</span></button></div></form>}
    <div class="account-switch">Đã có tài khoản? <a asp-action="Login">Đăng nhập</a></div>
</div></section>
