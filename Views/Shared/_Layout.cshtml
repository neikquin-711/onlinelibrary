<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] · OnLibrary</title><meta name="theme-color" content="#f8f7f3" />
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/account.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/reader.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/reader-library.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/users.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/reports.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/moderation.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/references.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/home-carousel.css" asp-append-version="true" />
</head>
<body>
<header class="topbar"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">o</span> onlibrary<span class="brand-dot">.</span></a>
  <nav class="main-nav"><a asp-controller="Home" asp-action="Index">Trang chủ</a><a asp-controller="Home" asp-action="Catalog">Khám phá</a><a asp-controller="Home" asp-action="Categories">Danh mục</a>@if(User.Identity?.IsAuthenticated == true){<a asp-controller="Home" asp-action="MyLibrary">Thư viện của tôi</a>}@if(User.IsInRole("Admin") || User.IsInRole("Librarian")){<a asp-controller="Home" asp-action="Admin">Quản lý</a><a asp-controller="Home" asp-action="References">Thư mục</a><a asp-controller="Home" asp-action="DocumentModeration">Duyệt tài liệu</a><a asp-controller="Home" asp-action="Reports">Báo cáo</a><a asp-controller="Home" asp-action="ReviewModeration">Nhận xét</a>}@if(User.IsInRole("Admin")){<a asp-controller="Home" asp-action="Settings">Cấu hình</a><a asp-controller="Home" asp-action="AuditLog">Nhật ký</a><a asp-controller="Home" asp-action="Users">Người dùng</a>}</nav>
  <div class="header-actions">@if(User.Identity?.IsAuthenticated == true){<a class="icon-button" asp-controller="Home" asp-action="MyLibrary" aria-label="Thư viện của tôi" title="Thư viện của tôi">♡</a><a class="signed-in-name" asp-controller="Account" asp-action="Profile" title="Hồ sơ cá nhân">@User.Identity.Name</a><form asp-controller="Account" asp-action="Logout" method="post"><button class="icon-button logout-button" aria-label="Đăng xuất" title="Đăng xuất">↪</button></form>}else{<a class="account-link" asp-controller="Account" asp-action="Login">Đăng nhập</a><a class="avatar" asp-controller="Account" asp-action="Register">A</a>}</div>
</header>
<main>@RenderBody()</main>
<footer class="footer"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">o</span> onlibrary<span class="brand-dot">.</span></a><span>Một không gian nhỏ cho những ý tưởng lớn.</span><span>© 2025 OnLibrary</span></footer>
<div id="toast" class="toast" role="status"></div><script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
