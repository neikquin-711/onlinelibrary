@model IReadOnlyList<LibraryDocument>
@{ ViewData["Title"] = "Duyệt tài liệu"; }
<section class="admin wrap">
    <div class="breadcrumbs"><a asp-action="Admin">Quản lý</a><span>/</span><span>Duyệt tài liệu</span></div>
    <div class="admin-heading"><div><div class="eyebrow"><span class="eyebrow-line"></span> KIỂM DUYỆT KHO SỐ</div><h1>Tài liệu <em>chờ duyệt.</em></h1><p>Chỉ tài liệu đã duyệt mới hiển thị trong trang tra cứu của độc giả.</p></div></div>
    @if(TempData["DocumentModerationNotice"] is not null){<div class="user-notice">@TempData["DocumentModerationNotice"]</div>}
    @if(Model.Count == 0){<div class="empty-state">Không còn tài liệu nào đang chờ duyệt.</div>}
    <div class="table-wrap"><table><thead><tr><th>TÀI LIỆU</th><th>THỂ LOẠI</th><th>ĐỊNH DẠNG</th><th>NGÀY XUẤT BẢN</th><th>THAO TÁC</th></tr></thead><tbody>
    @foreach(var item in Model){<tr><td><div class="table-title"><span class="table-initial @item.Color">@item.Initials</span><span><strong>@item.Title</strong><small>@item.Author · @item.Publisher</small></span></div><div class="moderation-description">@item.Description</div></td><td>@item.Category</td><td><span class="format-pill">@item.Format</span></td><td>@item.Year</td><td><div class="moderation-actions"><a asp-action="Details" asp-route-id="@item.Id">Xem</a><form asp-action="SetDocumentApproval" method="post"><input type="hidden" name="id" value="@item.Id"/><input type="hidden" name="approve" value="true"/><button type="submit" class="approve-button">Duyệt</button></form><form asp-action="SetDocumentApproval" method="post" onsubmit="return confirm('Từ chối tài liệu @item.Title?')"><input type="hidden" name="id" value="@item.Id"/><input type="hidden" name="approve" value="false"/><button type="submit" class="reject-button">Từ chối</button></form></div></td></tr>}
    </tbody></table></div>
</section>
