@model LibraryDocument
@using OnLibrary.Models
@{ ViewData["Title"] = "Sửa tài liệu"; var categories = ViewBag.Categories as IReadOnlyList<LibraryReference> ?? []; var authors = ViewBag.Authors as IReadOnlyList<LibraryReference> ?? []; var publishers = ViewBag.Publishers as IReadOnlyList<LibraryReference> ?? []; }
<section class="create-page wrap"><div class="breadcrumbs"><a asp-action="Admin">Quản lý</a><span>/</span><span>Sửa tài liệu</span></div><div class="create-card"><div class="eyebrow"><span class="eyebrow-line"></span> CẬP NHẬT KHO</div><h1>Sửa <em>thông tin sách.</em></h1><p>Chỉnh thông tin hoặc tải lên tệp thay thế. Bỏ trống nếu muốn giữ tệp hiện tại.</p>@if(ViewBag.Error is not null){<div class="form-error">@ViewBag.Error</div>}<form asp-action="Edit" method="post" enctype="multipart/form-data" class="document-form"><input type="hidden" name="id" value="@Model.Id"/><div class="form-field wide"><label for="title">Tên tài liệu</label><input id="title" name="title" maxlength="120" required value="@Model.Title"/></div><div class="form-field"><label for="author">Tác giả</label><select id="author" name="author" required>@foreach(var item in authors){<option value="@item.Name" selected="@(Model.Author == item.Name)">@item.Name</option>}</select></div><div class="form-field"><label for="year">Năm xuất bản</label><input id="year" name="year" type="number" min="1000" max="@DateTime.UtcNow.Year" required value="@Model.Year"/></div><div class="form-field"><label for="category">Danh mục</label><select id="category" name="category" required>@foreach(var item in categories){<option value="@item.Name" selected="@(Model.Category == item.Name)">@item.Name</option>}</select></div><div class="form-field"><label for="publisher">Nhà xuất bản</label><select id="publisher" name="publisher" required>@foreach(var item in publishers){<option value="@item.Name" selected="@(Model.Publisher == item.Name)">@item.Name</option>}</select></div><div class="form-field"><label for="format">Định dạng</label><select id="format" name="format"><option selected="@(Model.Format == "PDF")">PDF</option><option selected="@(Model.Format == "EPUB")">EPUB</option><option selected="@(Model.Format == "DOCX")">DOCX</option></select></div><div class="form-field wide"><label for="file">Tệp thay thế (không bắt buộc)</label><input id="file" name="file" type="file" accept=".pdf,.epub,.docx"/><small class="field-hint">@(Model.StoredFileName is null ? "Tài liệu chưa có tệp đính kèm." : $"Đang có tệp {Model.Format}, dung lượng {(Model.FileSizeBytes ?? 0) / 1024} KB.") Tệp mới tối đa 25 MB và sẽ được quét ClamAV.</small></div><div class="form-field wide"><label for="description">Mô tả</label><textarea id="description" name="description" maxlength="1000" rows="4" required>@Model.Description</textarea></div><div class="form-actions"><a class="outline-button" asp-action="Admin">Hủy</a><button class="primary-button" type="submit">Lưu thay đổi <span>→</span></button></div></form></div></section>
