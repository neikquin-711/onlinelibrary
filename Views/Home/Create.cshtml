@using OnLibrary.Models
@{ ViewData["Title"] = "Thêm tài liệu"; var categories = ViewBag.Categories as IReadOnlyList<LibraryReference> ?? []; var authors = ViewBag.Authors as IReadOnlyList<LibraryReference> ?? []; var publishers = ViewBag.Publishers as IReadOnlyList<LibraryReference> ?? []; }
<section class="create-page wrap"><div class="breadcrumbs"><a asp-action="Admin">Quản lý</a><span>/</span><span>Thêm tài liệu</span></div><div class="create-card"><div class="eyebrow"><span class="eyebrow-line"></span> KHO TÀI LIỆU</div><h1>Thêm <em>đầu sách mới.</em></h1><p>Nhập thông tin tài liệu và tải lên PDF, EPUB hoặc DOCX (tối đa 25 MB).</p>@if(ViewBag.Error is not null){<div class="form-error">@ViewBag.Error</div>}@if(categories.Count == 0 || authors.Count == 0 || publishers.Count == 0){<div class="form-error">Hãy tạo danh mục, tác giả và nhà xuất bản trước khi thêm sách. <a asp-action="References">Mở quản lý thư mục →</a></div>}<form asp-action="Create" method="post" enctype="multipart/form-data" class="document-form"><div class="form-field wide"><label for="title">Tên tài liệu</label><input id="title" name="title" maxlength="120" required placeholder="Ví dụ: Nhà giả kim"/></div><div class="form-field"><label for="author">Tác giả</label><select id="author" name="author" required><option value="">Chọn tác giả</option>@foreach(var item in authors){<option value="@item.Name">@item.Name</option>}</select></div><div class="form-field"><label for="year">Năm xuất bản</label><input id="year" name="year" type="number" min="1000" max="@DateTime.UtcNow.Year" required value="@DateTime.UtcNow.Year"/></div><div class="form-field"><label for="category">Danh mục</label><select id="category" name="category" required><option value="">Chọn danh mục</option>@foreach(var item in categories){<option value="@item.Name">@item.Name</option>}</select></div><div class="form-field"><label for="publisher">Nhà xuất bản</label><select id="publisher" name="publisher" required><option value="">Chọn nhà xuất bản</option>@foreach(var item in publishers){<option value="@item.Name">@item.Name</option>}</select></div><div class="form-field"><label for="format">Định dạng</label><select id="format" name="format"><option>PDF</option><option>EPUB</option><option>DOCX</option></select></div><div class="form-field wide"><label for="file">Tệp tài liệu</label><input id="file" name="file" type="file" accept=".pdf,.epub,.docx" required/><small class="field-hint">Tệp được kiểm tra định dạng và quét ClamAV trước khi lưu.</small></div><div class="form-field wide"><label for="description">Mô tả</label><textarea id="description" name="description" maxlength="1000" rows="4" required placeholder="Giới thiệu ngắn về tài liệu..."></textarea></div><div class="form-actions"><a class="outline-button" asp-action="Admin">Hủy</a><button class="primary-button" type="submit">Lưu tài liệu <span>→</span></button></div></form></div></section>
