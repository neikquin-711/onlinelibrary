@{ ViewData["Title"] = "Thêm tài liệu"; }
<section class="create-page wrap"><div class="breadcrumbs"><a asp-action="Admin">Quản lý</a><span>/</span><span>Thêm tài liệu</span></div><div class="create-card"><div class="eyebrow"><span class="eyebrow-line"></span> KHO TÀI LIỆU</div><h1>Thêm <em>đầu sách mới.</em></h1><p>Nhập thông tin tài liệu và tải lên PDF, EPUB hoặc DOCX (tối đa 25 MB).</p>@if(ViewBag.Error is not null){<div class="form-error">@ViewBag.Error</div>}<form asp-action="Create" method="post" enctype="multipart/form-data" class="document-form"><div class="form-field wide"><label for="title">Tên tài liệu</label><input id="title" name="title" maxlength="120" required placeholder="Ví dụ: Nhà giả kim"/></div><div class="form-field"><label for="author">Tác giả</label><input id="author" name="author" maxlength="100" required placeholder="Tên tác giả"/></div><div class="form-field"><label for="year">Năm xuất bản</label><input id="year" name="year" type="number" min="1000" max="@DateTime.UtcNow.Year" required value="@DateTime.UtcNow.Year"/></div><div class="form-field"><label for="category">Danh mục</label><select id="category" name="category"><option>Văn học</option><option>Tâm lý học</option><option>Kỹ năng sống</option><option>Lịch sử</option></select></div><div class="form-field"><label for="format">Định dạng</label><select id="format" name="format"><option>PDF</option><option>EPUB</option><option>DOCX</option></select></div><div class="form-field wide"><label for="file">Tệp tài liệu</label><input id="file" name="file" type="file" accept=".pdf,.epub,.docx" required/><small class="field-hint">Tệp được kiểm tra định dạng và quét ClamAV trước khi lưu.</small></div><div class="form-field wide"><label for="description">Mô tả</label><textarea id="description" name="description" maxlength="1000" rows="4" required placeholder="Giới thiệu ngắn về tài liệu..."></textarea></div><div class="form-actions"><a class="outline-button" asp-action="Admin">Hủy</a><button class="primary-button" type="submit">Lưu tài liệu <span>→</span></button></div></form></div></section>
