@model IReadOnlyList<LibraryDocument>
@{ ViewData["Title"] = "Quản trị thư viện"; }
<section class="admin wrap"><div class="admin-heading"><div><div class="eyebrow"><span class="eyebrow-line"></span> KHÔNG GIAN QUẢN TRỊ</div><h1>Tổng quan <em>thư viện.</em></h1><p>Chào buổi sáng, quản trị viên. Đây là những gì đang diễn ra hôm nay.</p></div><a class="primary-button" asp-action="Create">＋ &nbsp; Thêm tài liệu</a></div><div class="admin-stats"><div><span>TỔNG TÀI LIỆU</span><strong>@Model.Count</strong><small>Đầu sách trong thư viện</small></div><div><span>ĐỘC GIẢ</span><strong>2.406</strong><small>Độc giả đã tham gia</small></div><div><span>LƯỢT ĐỌC THÁNG NÀY</span><strong>8.942</strong><small>Lượt đọc trong tháng</small></div><div><span>CHỜ KIỂM DUYỆT</span><strong>06</strong><small class="pending">Cần xử lý hôm nay</small></div></div><div class="admin-table-head"><div><h2>Tài liệu gần đây</h2><p>Danh sách tài liệu trong thư viện</p></div><a class="text-link" asp-action="Catalog">Xem thư viện ↗</a></div><div class="table-wrap"><table><thead><tr><th>TÀI LIỆU</th><th>DANH MỤC</th><th>ĐỊNH DẠNG</th><th>NĂM</th><th>ĐÁNH GIÁ</th><th>TRẠNG THÁI</th><th></th></tr></thead><tbody>@foreach(var book in Model) { <tr><td><div class="table-title"><span class="table-initial @book.Color">@book.Initials</span><span><strong>@book.Title</strong><small>@book.Author</small></span></div></td><td>@book.Category</td><td><span class="format-pill">@book.Format</span></td><td>@book.Year</td><td>★ @book.Rating.ToString("0.0")</td><td><span class="status-pill">● Đã xuất bản</span></td><td><div class="row-actions"><a asp-action="Edit" asp-route-id="@book.Id">Sửa</a><form asp-action="Delete" method="post" onsubmit="return confirm('Xóa tài liệu @book.Title?')"><input type="hidden" name="id" value="@book.Id"/><button class="delete-button" type="submit">Xóa</button></form></div></td></tr> }</tbody></table></div></section>
