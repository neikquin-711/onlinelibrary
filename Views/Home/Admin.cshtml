@model AdminDashboardViewModel
@{ ViewData["Title"] = "Quản trị thư viện"; }
<section class="admin wrap"><div class="admin-heading"><div><div class="eyebrow"><span class="eyebrow-line"></span> KHÔNG GIAN QUẢN TRỊ</div><h1>Tổng quan <em>thư viện.</em></h1><p>Số liệu được tổng hợp trực tiếp từ hoạt động thư viện.</p></div><a class="outline-button" asp-action="DocumentModeration">Chờ duyệt (@Model.PendingApprovals)</a> <a class="primary-button" asp-action="Create">＋ &nbsp; Thêm tài liệu</a></div>
<div class="admin-stats"><div><span>TỔNG TÀI LIỆU</span><strong>@Model.TotalDocuments</strong><small>Đầu sách đang lưu</small></div><div><span>ĐỘC GIẢ</span><strong>@Model.TotalReaders</strong><small>Tài khoản độc giả</small></div><div><span>LƯỢT ĐỌC THÁNG NÀY</span><strong>@Model.ReadsThisMonth.ToString("N0")</strong><small>Lượt đọc ghi nhận khi đăng nhập</small></div><div><span>CHỜ KIỂM DUYỆT</span><strong>@Model.PendingReports</strong><small class="pending"><a asp-action="Reports">Mở hàng đợi báo cáo →</a></small></div></div>
<div class="admin-stats admin-stats-secondary"><div><span>LƯỢT TẢI XUỐNG THÁNG NÀY</span><strong>@Model.DownloadsThisMonth.ToString("N0")</strong><small>Ghi nhận từ độc giả đã đăng nhập</small></div></div>
<div class="admin-table-head"><div><h2>Tài liệu gần đây</h2><p>@Model.Documents.Count đầu sách trong danh mục</p></div><a class="text-link" asp-action="ExportStatistics">Xuất CSV ↓</a> &nbsp; <a class="text-link" asp-action="Catalog">Xem thư viện ↗</a></div><div class="table-wrap"><table><thead><tr><th>TÀI LIỆU</th><th>DANH MỤC</th><th>ĐỊNH DẠNG</th><th>NĂM</th><th>ĐÁNH GIÁ</th><th>TRẠNG THÁI</th><th></th></tr></thead><tbody>@foreach(var book in Model.Documents){<tr><td><div class="table-title"><span class="table-initial @book.Color">@book.Initials</span><span><strong>@book.Title</strong><small>@book.Author</small></span></div></td><td>@book.Category</td><td><span class="format-pill">@book.Format</span></td><td>@book.Year</td><td>★ @book.Rating.ToString("0.0")</td><td><span class="status-pill">@(book.IsApproved ? "Đã duyệt" : book.IsRejected ? "Đã từ chối" : "Chờ duyệt")</span></td><td><div class="row-actions"><a asp-action="Edit" asp-route-id="@book.Id">Sửa</a><form asp-action="Delete" method="post" onsubmit="return confirm('Xóa tài liệu @book.Title?')"><input type="hidden" name="id" value="@book.Id"/><button class="delete-button" type="submit">Xóa</button></form></div></td></tr>}</tbody></table></div></section>
