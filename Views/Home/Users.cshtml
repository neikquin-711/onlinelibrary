@model IReadOnlyList<LibraryUser>
@{ ViewData["Title"] = "Quản lý người dùng"; }
<section class="admin wrap"><div class="admin-heading"><div><div class="eyebrow"><span class="eyebrow-line"></span> QUẢN TRỊ TÀI KHOẢN</div><h1>Người dùng <em>thư viện.</em></h1><p>Cấp vai trò Thủ thư cho tài khoản cần quản lý kho tài liệu.</p></div><span class="user-count">@Model.Count tài khoản</span></div>
@if(TempData["UserAdminError"] is not null){<div class="form-error">@TempData["UserAdminError"]</div>}@if(TempData["UserAdminNotice"] is not null){<div class="user-notice">@TempData["UserAdminNotice"]</div>}
<div class="user-role-note"><strong>Admin</strong> có toàn quyền quản lý. <strong>Thủ thư</strong> có thể thêm, sửa và xóa tài liệu. <strong>Độc giả</strong> có thể lưu yêu thích, đánh giá và xem lịch sử đọc.</div>
<div class="table-wrap"><table><thead><tr><th>TÀI KHOẢN</th><th>NGÀY THAM GIA</th><th>VAI TRÒ</th><th>CẬP NHẬT VAI TRÒ</th></tr></thead><tbody>@foreach(var account in Model){<tr><td><div class="user-table-account"><span class="user-table-avatar">@account.DisplayName[..1].ToUpperInvariant()</span><span><strong>@account.DisplayName</strong><small>@account.Email</small></span></div></td><td>@account.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td><td><span class="role-pill @account.Role.ToLowerInvariant()">@(account.Role switch { "Admin" => "Quản trị viên", "Librarian" => "Thủ thư", _ => "Độc giả" })</span></td><td>@if(account.Role == "Admin"){<span class="role-locked">Được bảo vệ</span>}else{<form asp-action="SetUserRole" method="post" class="role-form"><input type="hidden" name="id" value="@account.Id"/><select name="role" aria-label="Vai trò của @account.DisplayName"><option value="Reader" selected="@(account.Role == "Reader")">Độc giả</option><option value="Librarian" selected="@(account.Role == "Librarian")">Thủ thư</option></select><button type="submit">Lưu</button></form>}</td></tr>}</tbody></table></div></section>
