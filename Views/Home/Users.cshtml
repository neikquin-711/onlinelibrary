@model IReadOnlyList<LibraryUser>
@{ ViewData["Title"] = "Quản lý người dùng"; }
<section class="admin wrap">
    <div class="admin-heading"><div><div class="eyebrow"><span class="eyebrow-line"></span> QUẢN TRỊ TÀI KHOẢN</div><h1>Người dùng <em>thư viện.</em></h1><p>Tạo, cập nhật, phân quyền hoặc xóa tài khoản độc giả và thủ thư.</p></div><span class="user-count">@Model.Count tài khoản</span></div>
    @if(TempData["UserAdminError"] is not null){<div class="form-error">@TempData["UserAdminError"]</div>}
    @if(TempData["UserAdminNotice"] is not null){<div class="user-notice">@TempData["UserAdminNotice"]</div>}
    <details class="user-create-panel"><summary>＋ Tạo tài khoản mới</summary><form asp-action="CreateUser" method="post" class="user-create-form">
        <label>Tên hiển thị<input name="displayName" maxlength="80" required /></label><label>Email<input name="email" type="email" maxlength="254" required /></label>
        <label>Mật khẩu tạm<input name="password" type="password" minlength="10" maxlength="128" required /></label>
        <label>Vai trò<select name="role"><option value="Reader">Độc giả</option><option value="Librarian">Thủ thư</option></select></label><button class="primary-button" type="submit">Tạo tài khoản</button>
    </form><p class="muted">Mật khẩu phải dài ít nhất 10 ký tự và có chữ hoa, chữ thường, chữ số.</p></details>
    <div class="user-role-note"><strong>Admin</strong> được bảo vệ. Quản trị viên có thể quản lý vai trò Reader và Librarian.</div>
    <div class="table-wrap"><table><thead><tr><th>TÀI KHOẢN</th><th>NGÀY THAM GIA</th><th>VAI TRÒ</th><th>QUẢN LÝ</th></tr></thead><tbody>
    @foreach(var account in Model){<tr><td><div class="user-table-account"><span class="user-table-avatar">@account.DisplayName[..1].ToUpperInvariant()</span><span><strong>@account.DisplayName</strong><small>@account.Email</small></span></div></td><td>@account.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td><td><span class="role-pill @account.Role.ToLowerInvariant()">@(account.Role switch { "Admin" => "Quản trị viên", "Librarian" => "Thủ thư", _ => "Độc giả" })</span></td><td>@if(account.Role == "Admin"){<span class="role-locked">Được bảo vệ</span>}else{<div class="user-row-actions"><a asp-action="EditUser" asp-route-id="@account.Id">Sửa tài khoản</a><form asp-action="DeleteUser" method="post" onsubmit="return confirm('Xóa tài khoản @account.Email và toàn bộ dữ liệu cá nhân liên quan?')"><input type="hidden" name="id" value="@account.Id"/><button class="delete-button" type="submit">Xóa</button></form></div>}</td></tr>}
    </tbody></table></div>
</section>
