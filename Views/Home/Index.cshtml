@model IReadOnlyList<LibraryDocument>
@{ ViewData["Title"] = "Thư viện của bạn"; }
<section class="hero wrap">
  <div class="hero-copy"><div class="eyebrow"><span class="eyebrow-line"></span> THƯ VIỆN SỐ CỦA BẠN</div><h1>Mở một cuốn sách.<br><em>Mở một thế giới.</em></h1><p>Khám phá kho tri thức được tuyển chọn dành riêng cho những tâm hồn ham học hỏi.</p>
    <form class="search-box" asp-controller="Home" asp-action="Catalog" method="get"><span class="search-icon">⌕</span><input name="q" placeholder="Tìm sách, tác giả, chủ đề..." /><button type="submit">Tìm kiếm <span>→</span></button></form>
    <div class="hero-note"><span class="avatar-stack"><i>H</i><i>M</i><i>L</i></span><span>Được yêu thích bởi <strong>2.400+</strong> độc giả</span></div>
  </div>
  <div class="hero-art"><div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div><div class="sun"></div><div class="hero-book book-back"><span>THE<br>ALCHEMIST</span><small>PAULO COELHO</small></div><div class="hero-book book-front"><span>THE<br>ART OF<br>READING</span><small>A QUIET MOMENT</small></div><div class="art-caption">01 — 08 <span>CURATED FOR YOU</span></div><div class="floating-note">✳ &nbsp; Hôm nay đọc gì?</div></div>
</section>
<section class="stats-strip"><div><strong>1.280<span>+</span></strong><small>ĐẦU SÁCH</small></div><div><strong>42</strong><small>CHỦ ĐỀ</small></div><div><strong>2.4k<span>+</span></strong><small>ĐỘC GIẢ</small></div><div class="stats-quote">“Đọc sách là cách ta sống thêm<br>một nghìn cuộc đời.”</div></section>
<section class="wrap section-block"><div class="section-heading"><div><div class="eyebrow"><span class="eyebrow-line"></span> ĐƯỢC TUYỂN CHỌN</div><h2>Đọc giả đang yêu thích</h2></div><a class="text-link" asp-controller="Home" asp-action="Catalog">Khám phá tất cả <span>↗</span></a></div>
<div class="book-grid">@foreach (var book in Model.Take(4)) { <article class="book-card"><a asp-action="Details" asp-route-id="@book.Id" class="cover @book.Color"><span class="cover-kicker">ONLIBRARY EDITION</span><span class="cover-title">@book.Title</span><span class="cover-author">@book.Author</span><span class="cover-seal">✳</span></a><div class="book-meta"><div><a class="book-title" asp-action="Details" asp-route-id="@book.Id">@book.Title</a><div class="book-author">@book.Author</div></div><form asp-action="Favorite" method="post"><input type="hidden" name="id" value="@book.Id"/><button class="save-button" aria-label="Lưu yêu thích" type="submit">♡</button></form></div><div class="book-foot"><span>★ @book.Rating.ToString("0.0")</span><span>@book.Category</span><span>@book.Format</span></div></article> }</div></section>
<section class="wrap category-section"><div class="section-heading"><div><div class="eyebrow"><span class="eyebrow-line"></span> TÌM THEO TÂM TRẠNG</div><h2>Điều bạn muốn khám phá?</h2></div><span class="muted">Một chủ đề hay có thể thay đổi cả ngày của bạn.</span></div><div class="category-grid">@{var categories = ViewBag.Categories as IReadOnlyList<LibraryReference> ?? []; var index = 1;}@foreach(var category in categories.Take(8)){<a asp-controller="Home" asp-action="Catalog" asp-route-category="@category.Name"><span>@index.ToString("00")</span><strong>@category.Name</strong><i>↗</i></a> index++;}</div></section>
