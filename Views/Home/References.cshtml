@model IReadOnlyList<LibraryReference>
@{ ViewData["Title"] = "Quản lý thư mục"; var groups = new[] { ("Category", "Danh mục"), ("Author", "Tác giả"), ("Publisher", "Nhà xuất bản") }; }
<section class="admin wrap"><div class="admin-heading"><div><div class="eyebrow"><span class="eyebrow-line"></span> THƯ MỤC THƯ VIỆN</div><h1>Danh mục &amp; đối tác <em>xuất bản.</em></h1><p>Quản lý danh sách dùng chung khi nhập tài liệu.</p></div></div>@if(TempData["ReferenceError"] is not null){<div class="form-error">@TempData["ReferenceError"]</div>}@if(TempData["ReferenceNotice"] is not null){<div class="user-notice">@TempData["ReferenceNotice"]</div>}
@foreach(var group in groups){var entries = Model.Where(entry => entry.Type == group.Item1).ToList();<section class="reference-group"><div class="reference-group-head"><div><h2>@group.Item2</h2><p>@entries.Count mục đã đăng ký</p></div><form asp-action="AddReference" method="post" class="reference-add"><input type="hidden" name="type" value="@group.Item1"/><input name="name" maxlength="120" required placeholder="Tên @group.Item2.ToLowerInvariant()"/><input name="description" maxlength="500" placeholder="Mô tả (không bắt buộc)"/><button class="primary-button" type="submit">＋ Thêm</button></form></div>@if(entries.Count == 0){<div class="library-empty">Chưa có mục nào.</div>}else{<div class="reference-list">@foreach(var entry in entries){<article class="reference-row"><form asp-action="RenameReference" method="post" class="reference-edit"><input type="hidden" name="id" value="@entry.Id"/><input name="name" maxlength="120" required value="@entry.Name" aria-label="Tên mục"/><input name="description" maxlength="500" value="@entry.Description" placeholder="Mô tả" aria-label="Mô tả"/><button type="submit">Lưu</button></form><form asp-action="DeleteReference" method="post" onsubmit="return confirm('Xóa @entry.Name khỏi danh mục dùng chung?')"><input type="hidden" name="id" value="@entry.Id"/><button class="delete-button" type="submit">Xóa</button></form></article>}</div>}</section>}
</section>
