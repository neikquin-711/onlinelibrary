@model IReadOnlyList<ReviewModerationRow>
@{ ViewData["Title"] = "Kiểm duyệt nhận xét"; }
<section class="admin wrap"><div class="admin-heading"><div><div class="eyebrow"><span class="eyebrow-line"></span> KIỂM DUYỆT CỘNG ĐỒNG</div><h1>Nhận xét <em>độc giả.</em></h1><p>Ẩn nội dung vi phạm hoặc khôi phục nhận xét đã được rà soát.</p></div><span class="user-count">@Model.Count nhận xét gần đây</span></div>@if(TempData["ReviewAdminNotice"] is not null){<div class="user-notice">@TempData["ReviewAdminNotice"]</div>}
@if(Model.Count == 0){<div class="library-empty">Chưa có nhận xét nào.</div>}else{<div class="moderation-list">@foreach(var review in Model){<article class="moderation-card"><div class="moderation-heading"><div><a asp-action="Details" asp-route-id="@review.DocumentId" class="moderation-book">@review.DocumentTitle</a><span class="moderation-author">@review.Reviewer · @review.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy")</span></div><span class="moderation-rating">@("★".PadLeft(review.Rating, '★'))@("☆".PadLeft(5-review.Rating, '☆'))</span></div><p class="moderation-comment">@review.Comment</p><div class="moderation-actions"><span class="moderation-visibility @(review.IsHidden ? "is-hidden" : "")">@(review.IsHidden ? "Đang ẩn" : "Đang hiển thị")</span><form asp-action="SetReviewVisibility" method="post"><input type="hidden" name="id" value="@review.Id"/><input type="hidden" name="hide" value="@(!review.IsHidden)"/><button class="@(review.IsHidden ? "outline-button" : "delete-button")" type="submit">@(review.IsHidden ? "Hiện lại" : "Ẩn nhận xét")</button></form></div></article>}</div>}</section>
