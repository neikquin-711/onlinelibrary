@model MyLibraryViewModel
@{ ViewData["Title"] = "Thư viện của tôi"; }
<section class="my-library wrap"><div class="eyebrow"><span class="eyebrow-line"></span> KHÔNG GIAN CỦA RIÊNG BẠN</div><h1>Thư viện <em>của tôi.</em></h1><p class="catalog-intro">Sách đã lưu và hành trình đọc gần đây.</p>
<div class="my-library-section"><div class="section-heading"><div><div class="eyebrow"><span class="eyebrow-line"></span> ĐỂ DÀNH SAU</div><h2>Yêu thích <span class="count-pill">@Model.Favorites.Count</span></h2></div><a class="text-link" asp-action="Catalog">Tìm thêm sách ↗</a></div>@if(Model.Favorites.Count == 0){<div class="library-empty">Chưa có sách yêu thích. Ghé trang khám phá và lưu những cuốn bạn muốn đọc nhé.</div>}else{<div class="book-grid">@foreach(var book in Model.Favorites){<article class="book-card"><a asp-action="Details" asp-route-id="@book.Id" class="cover @book.Color"><span class="cover-kicker">ONLIBRARY EDITION</span><span class="cover-title">@book.Title</span><span class="cover-author">@book.Author</span><span class="cover-seal">✳</span></a><div class="book-meta"><div><a class="book-title" asp-action="Details" asp-route-id="@book.Id">@book.Title</a><div class="book-author">@book.Author</div></div><span class="saved-heart">♥</span></div><div class="book-foot"><span>@book.Category</span><span>@book.Format</span></div></article>}</div>}</div>
<div class="my-library-section history-section"><div class="section-heading"><div><div class="eyebrow"><span class="eyebrow-line"></span> TIẾP TỤC HÀNH TRÌNH</div><h2>Lịch sử đọc <span class="count-pill">@Model.History.Count</span></h2></div></div>@if(Model.History.Count == 0){<div class="library-empty">Lịch sử đọc sẽ hiện ở đây sau khi bạn mở một tài liệu.</div>}else{<div class="history-list">@foreach(var item in Model.History){<a class="history-row" asp-action="Details" asp-route-id="@item.Document.Id"><span class="history-initial @item.Document.Color">@item.Document.Initials</span><span class="history-book"><strong>@item.Document.Title</strong><small>@item.Document.Author</small></span><span class="history-open">Đã mở @item.OpenCount lần</span><span class="history-date">@item.LastReadAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span><span class="history-arrow">↗</span></a>}</div>}</div></section>
