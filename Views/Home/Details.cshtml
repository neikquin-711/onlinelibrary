@model LibraryDocument
@{ ViewData["Title"] = Model.Title; var reviews = ViewBag.Reviews as IReadOnlyList<ReviewCard> ?? []; var myReview = ViewBag.MyReview as LibraryReview; }
<section class="detail wrap"><div class="breadcrumbs"><a asp-action="Index">Trang chủ</a><span>/</span><a asp-action="Catalog">Khám phá</a><span>/</span><span>@Model.Title</span></div><div class="detail-layout"><div class="detail-cover-wrap"><div class="cover detail-cover @Model.Color"><span class="cover-kicker">ONLIBRARY EDITION</span><span class="cover-title">@Model.Title</span><span class="cover-author">@Model.Author</span><span class="cover-seal">✳</span></div><div class="cover-shadow"></div></div><div class="detail-info"><div class="eyebrow"><span class="eyebrow-line"></span> @Model.Category.ToUpper()</div><h1>@Model.Title</h1><p class="detail-author">bởi <strong>@Model.Author</strong></p><div class="rating-line"><span>★★★★★</span><strong>@(((double)ViewBag.AverageRating).ToString("0.0"))</strong><span class="muted">(@ViewBag.ReviewCount đánh giá)</span></div><p class="detail-description">@Model.Description</p><div class="detail-facts"><div><small>ĐỊNH DẠNG</small><strong>@Model.Format</strong></div><div><small>NĂM XUẤT BẢN</small><strong>@Model.Year</strong></div><div><small>NHÀ XUẤT BẢN</small><strong>@Model.Publisher</strong></div><div><small>LƯỢT ĐỌC</small><strong>@Model.Reads.ToString("N0")</strong></div></div><div class="detail-actions">@if(Model.StoredFileName is not null){if(Model.Format == "PDF"){<a class="primary-button" asp-action="Read" asp-route-id="@Model.Id">Đọc ngay <span>→</span></a>}@if(Model.Format == "EPUB"){<a class="primary-button" asp-action="Read" asp-route-id="@Model.Id">Đọc ngay <span>→</span></a>}<a class="outline-button" asp-action="DocumentFile" asp-route-id="@Model.Id" asp-route-download="true">Tải @Model.Format ↓</a>}else{<span class="muted">Chưa có tệp đính kèm</span>}<form asp-action="Favorite" method="post"><input type="hidden" name="id" value="@Model.Id"/><button class="outline-button" type="submit">@(ViewBag.IsFavorite ? "♥ Đã yêu thích" : "♡ Lưu yêu thích")</button></form></div><div class="detail-note">✦ &nbsp; @if(Model.StoredFileName is not null){<span>Tệp đã được quét bảo mật · @((Model.FileSizeBytes ?? 0) / 1024) KB</span>}else{<span>Thông tin sách mẫu</span>}</div></div></div>
<section class="review-section" id="reviews"><div class="review-heading"><div><div class="eyebrow"><span class="eyebrow-line"></span> CỘNG ĐỒNG ĐỘC GIẢ</div><h2>Đánh giá &amp; nhận xét</h2></div><div class="review-summary"><strong>@(((double)ViewBag.AverageRating).ToString("0.0"))</strong><span>★★★★★<small>@ViewBag.ReviewCount lượt đánh giá</small></span></div></div>
<div class="review-grid"><div class="review-list">@if(reviews.Count == 0){<p class="review-empty">Chưa có nhận xét nào. Hãy là người đầu tiên chia sẻ cảm nhận của bạn.</p>}else{@foreach(var review in reviews){<article class="review-card"><div class="review-card-top"><div class="review-avatar">@review.DisplayName[..1].ToUpperInvariant()</div><div><strong>@review.DisplayName</strong><small>@review.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy")</small></div><span class="review-stars">@("★".PadLeft(review.Rating, '★'))@("☆".PadLeft(5-review.Rating, '☆'))</span></div><p>@review.Comment</p></article>}}</div>
<div class="review-form-card"><h3>@(myReview is null ? "Chia sẻ cảm nhận" : "Cập nhật đánh giá")</h3><p>Mỗi độc giả có một đánh giá cho mỗi tài liệu.</p>@if(TempData["ReviewError"] is not null){<div class="form-error">@TempData["ReviewError"]</div>}@if(User.Identity?.IsAuthenticated == true){<form asp-action="Review" method="post"><input type="hidden" name="id" value="@Model.Id"/><label for="rating">Đánh giá của bạn</label><select id="rating" name="rating" required><option value="">Chọn số sao</option>@for(var star=5;star>=1;star--){<option value="@star" selected="@(myReview?.Rating == star)">@star sao</option>}</select><label for="comment">Nhận xét</label><textarea id="comment" name="comment" rows="5" maxlength="1000" required placeholder="Bạn nghĩ gì về cuốn sách này?">@myReview?.Comment</textarea><button class="primary-button" type="submit">Gửi đánh giá <span>→</span></button></form>}else{<p class="review-login">Vui lòng <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Home/Details/@Model.Id#reviews">đăng nhập</a> để yêu thích và đánh giá.</p>}</div></div>
<div class="report-book-card" id="report"><div><div class="eyebrow"><span class="eyebrow-line"></span> GIÚP THƯ VIỆN TỐT HƠN</div><h3>Báo cáo vấn đề với tài liệu này</h3><p>Báo nếu tệp bị lỗi, thông tin chưa chính xác hoặc nội dung có vấn đề.</p></div>@if(TempData["ReportError"] is not null){<div class="form-error">@TempData["ReportError"]</div>}@if(TempData["ReportNotice"] is not null){<div class="user-notice">@TempData["ReportNotice"]</div>}@if(User.Identity?.IsAuthenticated == true){<form asp-action="SubmitReport" method="post"><input type="hidden" name="id" value="@Model.Id"/><select name="reason" aria-label="Lý do báo cáo" required><option value="">Chọn lý do</option><option>Tệp bị lỗi</option><option>Thông tin chưa chính xác</option><option>Nội dung vi phạm</option><option>Khác</option></select><textarea name="details" maxlength="1000" rows="3" required placeholder="Mô tả ngắn vấn đề..."></textarea><button class="outline-button" type="submit">Gửi báo cáo</button></form>}else{<a class="report-login" asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Home/Details/@Model.Id#report">Đăng nhập để gửi báo cáo →</a>}</div></section></section>
