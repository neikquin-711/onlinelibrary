@model IReadOnlyList<DocumentReportRow>
@{ ViewData["Title"] = "Báo cáo tài liệu"; }
<section class="admin wrap"><div class="admin-heading"><div><div class="eyebrow"><span class="eyebrow-line"></span> KIỂM DUYỆT NỘI DUNG</div><h1>Báo cáo <em>tài liệu.</em></h1><p>Xem xét phản hồi từ độc giả và cập nhật trạng thái xử lý.</p></div><span class="user-count">@Model.Count báo cáo gần đây</span></div>
@if(TempData["ReportAdminError"] is not null){<div class="form-error">@TempData["ReportAdminError"]</div>}@if(TempData["ReportAdminNotice"] is not null){<div class="user-notice">@TempData["ReportAdminNotice"]</div>}
@if(Model.Count == 0){<div class="library-empty">Chưa có báo cáo nào.</div>}else{<div class="report-list">@foreach(var report in Model){<article class="report-card"><div class="report-top"><div><a class="report-book" asp-action="Details" asp-route-id="@report.DocumentId">@report.DocumentTitle</a><span class="report-reason">@report.Reason</span></div><span class="report-status @report.Status.ToLowerInvariant()">@(report.Status switch { "Pending" => "Chờ xử lý", "Resolved" => "Đã xử lý", _ => "Đã từ chối" })</span></div><p class="report-details">@report.Details</p><div class="report-meta"><span>Báo cáo bởi <strong>@report.Reporter</strong></span><span>@report.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>@if(report.ResolvedBy is not null){<span>Xử lý bởi @report.ResolvedBy</span>}</div>@if(report.Status == "Pending"){<div class="report-actions"><form asp-action="ResolveReport" method="post"><input type="hidden" name="reportId" value="@report.Id"/><input type="hidden" name="decision" value="Resolved"/><button class="primary-button" type="submit">Đánh dấu đã xử lý</button></form><form asp-action="ResolveReport" method="post"><input type="hidden" name="reportId" value="@report.Id"/><input type="hidden" name="decision" value="Rejected"/><button class="outline-button" type="submit">Từ chối báo cáo</button></form></div>}</article>}</div>}</section>
