@model CatalogViewModel
@{
    ViewData["Title"] = "Khám phá sách";
    var categories = ViewBag.Categories as IReadOnlyList<string> ?? [];
    var authors = ViewBag.Authors as IReadOnlyList<string> ?? [];
}
<section class="catalog wrap">
    <div class="eyebrow"><span class="eyebrow-line"></span> KHO TRI THỨC</div>
    <h1>Khám phá <em>điều mới.</em></h1>
    <p class="catalog-intro">Tìm cuốn sách tiếp theo dành cho bạn.</p>
    <form method="get" class="catalog-filters">
        <label class="catalog-search-field">Từ khóa
            <input name="q" value="@Model.Query" placeholder="Tên sách, tác giả, chủ đề..." />
        </label>
        <label>Danh mục
            <select name="category"><option value="">Tất cả danh mục</option>@foreach (var item in categories){<option value="@item" selected="@(Model.Category == item)">@item</option>}</select>
        </label>
        <label>Tác giả
            <select name="author"><option value="">Tất cả tác giả</option>@foreach (var item in authors){<option value="@item" selected="@(Model.Author == item)">@item</option>}</select>
        </label>
        <label>Từ năm<input name="yearFrom" type="number" min="1000" max="2100" value="@Model.YearFrom" placeholder="Ví dụ 2000" /></label>
        <label>Đến năm<input name="yearTo" type="number" min="1000" max="2100" value="@Model.YearTo" placeholder="Ví dụ 2025" /></label>
        <label>Sắp xếp<select name="sort"><option value="popular" selected="@(Model.Sort == "popular")">Phổ biến</option><option value="newest" selected="@(Model.Sort == "newest")">Mới nhất</option><option value="rating" selected="@(Model.Sort == "rating")">Đánh giá cao</option></select></label>
        <button class="primary-button" type="submit">Lọc tài liệu <span>→</span></button>
        <a class="outline-button" asp-action="Catalog">Xóa bộ lọc</a>
    </form>
    <div class="results-line"><span><strong>@Model.TotalResults</strong> tài liệu · Trang @Model.Page/@Model.TotalPages</span><span>12 kết quả mỗi trang</span></div>
    <div class="book-grid">
        @foreach (var book in Model.Documents)
        {
            <article class="book-card">
                <a asp-action="Details" asp-route-id="@book.Id" class="cover @book.Color"><span class="cover-kicker">ONLIBRARY EDITION</span><span class="cover-title">@book.Title</span><span class="cover-author">@book.Author</span><span class="cover-seal">✳</span></a>
                <div class="book-meta"><div><a class="book-title" asp-action="Details" asp-route-id="@book.Id">@book.Title</a><div class="book-author">@book.Author</div></div><form asp-action="Favorite" method="post"><input type="hidden" name="id" value="@book.Id"/><button class="save-button" type="submit" aria-label="Lưu yêu thích">♡</button></form></div>
                <div class="book-foot"><span>★ @book.Rating.ToString("0.0")</span><span>@book.Category</span><span>@book.Year</span><span>@book.Format</span></div>
            </article>
        }
    </div>
    @if (Model.TotalResults == 0){<div class="empty-state">Không tìm thấy tài liệu phù hợp. Hãy thử thay đổi bộ lọc.</div>}
    @if (Model.TotalPages > 1)
    {
        <nav class="pagination" aria-label="Phân trang">
            @if(Model.Page > 1){<a asp-action="Catalog" asp-route-q="@Model.Query" asp-route-category="@Model.Category" asp-route-author="@Model.Author" asp-route-yearFrom="@Model.YearFrom" asp-route-yearTo="@Model.YearTo" asp-route-sort="@Model.Sort" asp-route-page="@(Model.Page - 1)">← Trước</a>}else{<span class="disabled">← Trước</span>}
            <span class="pagination-current">@Model.Page / @Model.TotalPages</span>
            @if(Model.Page < Model.TotalPages){<a asp-action="Catalog" asp-route-q="@Model.Query" asp-route-category="@Model.Category" asp-route-author="@Model.Author" asp-route-yearFrom="@Model.YearFrom" asp-route-yearTo="@Model.YearTo" asp-route-sort="@Model.Sort" asp-route-page="@(Model.Page + 1)">Tiếp →</a>}else{<span class="disabled">Tiếp →</span>}
        </nav>
    }
</section>
