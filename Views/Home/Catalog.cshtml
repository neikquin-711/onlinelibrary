@model IReadOnlyList<LibraryDocument>
@{ ViewData["Title"] = "Khám phá sách"; }
<section class="catalog wrap"><div class="eyebrow"><span class="eyebrow-line"></span> KHO TRI THỨC</div><h1>Khám phá <em>điều mới.</em></h1><p class="catalog-intro">Tìm cuốn sách tiếp theo dành cho bạn.</p><form class="search-box catalog-search" method="get"><span class="search-icon">⌕</span><input name="q" value="@ViewBag.Query" placeholder="Tên sách, tác giả, chủ đề..."/><button>Tìm kiếm <span>→</span></button></form>
<div class="filter-row"><div class="filter-chips"><a class="chip @(ViewBag.Category == "Tất cả" ? "active" : "")" href="/Home/Catalog">Tất cả</a>@foreach (var cat in new[] { "Văn học", "Tâm lý học", "Kỹ năng sống", "Lịch sử" }) { <a class="chip @(ViewBag.Category == cat ? "active" : "")" href="/Home/Catalog?category=@Uri.EscapeDataString(cat)">@cat</a> }</div><form method="get" class="sort-form"><input type="hidden" name="q" value="@ViewBag.Query"/><input type="hidden" name="category" value="@ViewBag.Category"/><label for="sort">Sắp xếp</label><select id="sort" name="sort" onchange="this.form.submit()"><option value="popular" selected="@(ViewBag.Sort == "popular")">Phổ biến</option><option value="newest" selected="@(ViewBag.Sort == "newest")">Mới nhất</option><option value="rating" selected="@(ViewBag.Sort == "rating")">Đánh giá cao</option></select></form></div>
<div class="results-line"><span><strong>@Model.Count</strong> cuốn sách dành cho bạn</span><span>Hiển thị tất cả kết quả</span></div><div class="book-grid">@foreach (var book in Model) { <article class="book-card"><a asp-action="Details" asp-route-id="@book.Id" class="cover @book.Color"><span class="cover-kicker">ONLIBRARY EDITION</span><span class="cover-title">@book.Title</span><span class="cover-author">@book.Author</span><span class="cover-seal">✳</span></a><div class="book-meta"><div><a class="book-title" asp-action="Details" asp-route-id="@book.Id">@book.Title</a><div class="book-author">@book.Author</div></div><form asp-action="Favorite" method="post"><input type="hidden" name="id" value="@book.Id"/><button class="save-button" type="submit">♡</button></form></div><div class="book-foot"><span>★ @book.Rating.ToString("0.0")</span><span>@book.Category</span><span>@book.Format</span></div></article> }</div>@if (!Model.Any()) { <div class="empty-state">Không tìm thấy cuốn sách phù hợp. Thử một từ khóa khác nhé.</div> }</section>
