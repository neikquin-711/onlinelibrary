@model CatalogViewModel
@{ ViewData["Title"] = "Khám phá sách"; var categories = ViewBag.Categories as IReadOnlyList<string> ?? []; }
<section class="catalog wrap"><div class="eyebrow"><span class="eyebrow-line"></span> KHO TRI THỨC</div><h1>Khám phá <em>điều mới.</em></h1><p class="catalog-intro">Tìm cuốn sách tiếp theo dành cho bạn.</p><form class="search-box catalog-search" method="get"><span class="search-icon">⌕</span><input name="q" value="@Model.Query" placeholder="Tên sách, tác giả, chủ đề..."/><input type="hidden" name="category" value="@Model.Category"/><input type="hidden" name="sort" value="@Model.Sort"/><button>Tìm kiếm <span>→</span></button></form>
<div class="filter-row"><div class="filter-chips"><a class="chip @(Model.Category == "Tất cả" ? "active" : "")" asp-action="Catalog" asp-route-q="@Model.Query" asp-route-sort="@Model.Sort">Tất cả</a>@foreach (var cat in categories) { <a class="chip @(Model.Category == cat ? "active" : "")" asp-action="Catalog" asp-route-q="@Model.Query" asp-route-category="@cat" asp-route-sort="@Model.Sort">@cat</a> }</div><form method="get" class="sort-form"><input type="hidden" name="q" value="@Model.Query"/><input type="hidden" name="category" value="@Model.Category"/><label for="sort">Sắp xếp</label><select id="sort" name="sort" onchange="this.form.submit()"><option value="popular" selected="@(Model.Sort == "popular")">Phổ biến</option><option value="newest" selected="@(Model.Sort == "newest")">Mới nhất</option><option value="rating" selected="@(Model.Sort == "rating")">Đánh giá cao</option></select></form></div>
<div class="results-line"><span><strong>@Model.TotalResults</strong> cuốn sách · Trang @Model.Page/@Model.TotalPages</span><span>12 kết quả mỗi trang</span></div><div class="book-grid">@foreach (var book in Model.Documents) { <article class="book-card"><a asp-action="Details" asp-route-id="@book.Id" class="cover @book.Color"><span class="cover-kicker">ONLIBRARY EDITION</span><span class="cover-title">@book.Title</span><span class="cover-author">@book.Author</span><span class="cover-seal">✳</span></a><div class="book-meta"><div><a class="book-title" asp-action="Details" asp-route-id="@book.Id">@book.Title</a><div class="book-author">@book.Author</div></div><form asp-action="Favorite" method="post"><input type="hidden" name="id" value="@book.Id"/><button class="save-button" type="submit">♡</button></form></div><div class="book-foot"><span>★ @book.Rating.ToString("0.0")</span><span>@book.Category</span><span>@book.Format</span></div></article> }</div>
@if(Model.TotalResults == 0){<div class="empty-state">Không tìm thấy cuốn sách phù hợp. Thử một từ khóa khác nhé.</div>}
@if(Model.TotalPages > 1){<nav class="pagination" aria-label="Phân trang">@if(Model.Page > 1){<a asp-action="Catalog" asp-route-q="@Model.Query" asp-route-category="@Model.Category" asp-route-sort="@Model.Sort" asp-route-page="@(Model.Page - 1)">← Trước</a>}else{<span class="disabled">← Trước</span>}<span class="pagination-current">@Model.Page / @Model.TotalPages</span>@if(Model.Page < Model.TotalPages){<a asp-action="Catalog" asp-route-q="@Model.Query" asp-route-category="@Model.Category" asp-route-sort="@Model.Sort" asp-route-page="@(Model.Page + 1)">Tiếp →</a>}else{<span class="disabled">Tiếp →</span>}</nav>}</section>
