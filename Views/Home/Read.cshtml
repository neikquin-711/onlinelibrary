@model LibraryDocument
@{ ViewData["Title"] = "Đang đọc · " + Model.Title; }
<section class="reader-page"><div class="reader-toolbar"><a asp-action="Details" asp-route-id="@Model.Id" class="reader-back">← <span>Quay lại</span></a><div class="reader-book-name"><strong>@Model.Title</strong><span>@Model.Author</span></div><div class="reader-controls">@if(Model.Format == "PDF" && Model.StoredFileName is not null){<a class="reader-download" asp-action="DocumentFile" asp-route-id="@Model.Id" asp-route-download="true">Tải xuống ↓</a>}</div></div>@if(Model.StoredFileName is null){<div class="reader-empty"><h1>Chưa có tệp để đọc</h1><p>Tài liệu này mới có thông tin giới thiệu.</p></div>}else if(Model.Format == "PDF"){<iframe class="pdf-reader" title="Đọc @Model.Title" src="@Url.Action("DocumentFile", "Home", new { id = Model.Id })"></iframe>}else if(Model.Format == "EPUB"){<div class="reader-empty"><h1>Tệp EPUB sẵn sàng</h1><p>Tải tệp về để mở bằng ứng dụng đọc EPUB trên thiết bị của bạn.</p><a class="primary-button" asp-action="DocumentFile" asp-route-id="@Model.Id" asp-route-download="true">Tải EPUB <span>↓</span></a></div>}else{<div class="reader-empty"><h1>Tệp DOCX sẵn sàng</h1><p>Tải tệp về để mở bằng trình đọc DOCX trên thiết bị của bạn.</p><a class="primary-button" asp-action="DocumentFile" asp-route-id="@Model.Id" asp-route-download="true">Tải DOCX <span>↓</span></a></div>}</section>
